# =============================================================================
# API KEYS FOR DDI DATABASE DOWNLOADS
# =============================================================================
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git (it's in .gitignore)
# =============================================================================

# Semantic Scholar API (for literature search)
# Get key at: https://www.semanticscholar.org/product/api
S2_API_KEY=your_semantic_scholar_api_key_here

# DrugBank API (requires academic license - free for non-commercial)
# Register at: https://go.drugbank.com/
DRUGBANK_API_KEY=your_drugbank_api_key_here

# PubChem (no key required - public API)
# PUBCHEM_API_KEY=not_required

# ChEMBL (no key required - public API)
# CHEMBL_API_KEY=not_required

# PharmGKB (no key required for bulk downloads)
# PHARMGKB_API_KEY=not_required

# UniProt (no key required - public API)
# UNIPROT_API_KEY=not_required

# CPIC (no key required - public API)
# CPIC_API_KEY=not_required
